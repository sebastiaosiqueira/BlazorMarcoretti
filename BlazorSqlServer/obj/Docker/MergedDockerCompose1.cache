name: dockercompose174093527717230202
services:
  SqlServerDb:
    container_name: SqlServerContainer
    environment:
      ACCEPT_EULA: Y/
      MSSQL_SA_PASSWORD: Numsey#2024
    image: mcr.microsoft.com/mssql/server:2017-latest
    networks:
      minhaAppNetwork: null
    ports:
      - mode: ingress
        target: 1433
        published: "8002"
        protocol: tcp
  blazorsqlserver:
    build:
      context: C:\Users\3346.ADM-UCDB\source\repos\BlazorSqlServer
      dockerfile: BlazorSqlServer/Dockerfile
    container_name: BlazorContainer
    depends_on:
      SqlServerDb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
    image: blazorsqlserver
    networks:
      minhaAppNetwork: null
    ports:
      - mode: ingress
        target: 8080
        published: "8001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\3346.ADM-UCDB\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\3346.ADM-UCDB\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\3346.ADM-UCDB\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\3346.ADM-UCDB\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind: {}
networks:
  minhaAppNetwork:
    name: dockercompose174093527717230202_minhaAppNetwork
    driver: bridge