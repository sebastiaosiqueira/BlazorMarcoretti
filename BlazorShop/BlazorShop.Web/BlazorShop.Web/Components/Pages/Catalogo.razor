@page "/produtos"
@using BlazorShop.Web.Shared
@inject IProdutoService produtoService
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<ExibirSpinner Carregando="@(Produtos == null)">

 
    <MudText Typo="Typo.h4">Produtos</MudText>
    @if (Produtos.Count() > 0)
    {
        var produtosPorCategoria = from produto in Produtos
                                   group produto by produto.CategoriaId
                                   into prodPorCatGrupo
                                   orderby prodPorCatGrupo.Key
                                   select prodPorCatGrupo;
        @foreach (var prodGrupo in produtosPorCategoria)
        {
            <MudText Typo="Typo.h5">@prodGrupo.FirstOrDefault(pg => pg.CategoriaId == prodGrupo.Key).CategoriaNome</MudText>


            <MudGrid>
                <ExibirProdutos Produtos="@prodGrupo" />
            </MudGrid>
            <MudDivider DividerType="DividerType.Middle" Class="my-6" />
        }
       
    }
</ExibirSpinner>


    @code {

    public IEnumerable<ProdutoDto>? Produtos { get; set; }
    [Inject] ICarrinhoCompraService? carrinhoCompraService{ get; set; }

    protected override async Task OnInitializedAsync()
    {

        // Garante que o estado inicial é nulo
        Produtos = null;

        try
        {
            // Busca os dados (o Task.Delay aqui vai fazer o spinner brilhar!)
            await Task.Delay(300);

            Produtos = await produtoService.GetItens();

            var carrinhoCompraItens = await carrinhoCompraService.GetItens(UsuarioLogado.UsuarioId);
           var totalQuantidade = carrinhoCompraItens.Sum(i => i.Quantidade);
          
            carrinhoCompraService.RaiseEventOnCarrinhoCompraChanged(totalQuantidade);
            
        }
        catch(Exception ex)
        {
            Snackbar.Add(ex.Message!, Severity.Error, config =>
              {
                  config.Icon = Icons.Material.Filled.Error;
              });
        }
        finally
        {
            // O Blazor atualizará a tela automaticamente aqui para mostrar os produtos
        }

    }
    }

