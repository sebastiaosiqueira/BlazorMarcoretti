
@page "/carrinhocompra"

<h3>CarrinhoCompra</h3>
@if (CarrinhoCompraItens == null || CarrinhoCompraItens.Count == 0)
{
    <p>O seu carrinho está vazio 🛒</p>
}
else
{

    <MudGrid Spacing="4" Class="mt-8">

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5" Class="mb-4">Seus Itens</MudText>

            <MudGrid>
                @foreach (var item in CarrinhoCompraItens)
                {
                    <MudItem xs="12" sm="6">
                        <MudCard Style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                           
                            <MudCardMedia Image="@item.ProdutoImagemUrl" Height="200" />

                            <MudCardContent>
                                <MudText Typo="Typo.h6">@item.ProdutoNome</MudText>
                                <MudText Typo="Typo.body2" Class="text-secondary" Style="height: 40px; overflow: hidden;">
                                    @item.ProdutoDescricao
                                </MudText>
                                <MudText Typo="Typo.body1" Class="mt-2" Color="Color.Primary">
                                    <b>@item.Preco.ToString("C")</b>
                                </MudText>
                                <MudTextField @bind-Value="@item.Quantidade" Label="Quantidade" />
                                <MudButton OnClick="(() => AtualizaQuantidadeCarrinhoItem_Cick(item.Id, item.Quantidade))" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Update">
                                    Atualizar
                                </MudButton>
                            </MudCardContent>

                            <MudCardActions>
                                <MudButton OnClick="(()=> DeletaCarrinhoItem_Click(item.Id))" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete">
                                    Excluir
                                </MudButton>
                            </MudCardActions>

                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudText Typo="Typo.h5" Class="mb-4">Resumo do Pedido</MudText>

            <MudPaper Elevation="4" Class="pa-6" Style="border-radius: 8px;">
                <div class="d-flex justify-space-between mb-2">
                    <MudText Typo="Typo.body1" Class="text-secondary">Quantidade de Itens:</MudText>
                    <MudText Typo="Typo.body1"><b>@CarrinhoCompraItens.Sum(i => i.Quantidade)</b></MudText>
                </div>

                <div class="d-flex justify-space-between mb-4">
                    <MudText Typo="Typo.body1" Class="text-secondary">Frete:</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Success"><b>Grátis</b></MudText>
                </div>

                <MudDivider Class="my-4" />

                <div class="d-flex justify-space-between align-center mb-6">
                    <MudText Typo="Typo.h6">Total:</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <b>@CarrinhoCompraItens.Sum(item => item.Preco * item.Quantidade).ToString("C")</b>
                    </MudText>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.AddCard">
                    Fechar Pedido
                </MudButton>
            </MudPaper>
        </MudItem>

    </MudGrid>
}
@code {
    [Inject]
    public ICarrinhoCompraService? CarrinhoCompraService{ get; set; }

    public List<CarrinhoItemDto>? CarrinhoCompraItens { get; set; } = new List<CarrinhoItemDto>();



    protected override async Task OnInitializedAsync()
    {
        try
        {
            var itens  = await CarrinhoCompraService.GetItens(UsuarioLogado.UsuarioId);
            if(itens != null)
            {
                CarrinhoCompraItens = itens.ToList();
                CarrinhoChanged();
            }   
        }
        catch(Exception ex)
        {
            Snackbar.Add(ex.Message!, Severity.Error, config =>
            {
                config.Icon = Icons.Material.Filled.Error;
            });
        }   
    }

    protected async Task DeletaCarrinhoItem_Click(int id)
    {
        var carrinhoItemDto = await CarrinhoCompraService.DeletaItem(id);

        //remoção do item da coleção local para atualizar a interface
        await RemoveCarrinhoItem(id);
    }

    private CarrinhoItemDto GetCarrinhoItem(int id)
    {
        return CarrinhoCompraItens.FirstOrDefault(i => i.Id == id);
    }

    private async Task RemoveCarrinhoItem(int id)
    {
        var carrinhoItemDto = GetCarrinhoItem(id);
        CarrinhoCompraItens.Remove(carrinhoItemDto);
    }

    protected async Task AtualizaQuantidadeCarrinhoItem_Cick(int id, int quantidade)
    {
        try
        {
            if (quantidade > 0)
            {
                var atualizaItemDto = new CarrinhoItemAtualizaQuantidadeDto
                    {
                        CarrinhoItemId = id,
                        Quantidade = quantidade
                    };

                var retornaItemAtualiazado = await CarrinhoCompraService.AtualizaQuantidade(atualizaItemDto);

            }
            else
            {
                var item = CarrinhoCompraItens.FirstOrDefault(i => i.Id == id);
                if(item is not null)
                {
                    item.Quantidade = 1;
                    item.PrecoTotal = item.Preco;
                }
            }

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message!, Severity.Error, config =>
            {
                config.Icon = Icons.Material.Filled.Error;
            });
        }
    }

    private void CarrinhoChanged()
    {
        CalculaResmoCarrinhoTotal();
        CarrinhoCompraService.RaiseEventOnCarrinhoCompraChanged(CarrinhoCompraItens.Sum(i => i.Quantidade));
    }

    private void CalculaResmoCarrinhoTotal()
    {
        var total = CarrinhoCompraItens.Sum(i => i.Preco * i.Quantidade);
    }
}
