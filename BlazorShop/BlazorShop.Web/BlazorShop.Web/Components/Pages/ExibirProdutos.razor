

@foreach (var item in Produtos)
{
    <MudItem xs="12" sm="6" md="4" lg="3">
        <MudCard Style="width: 300px;">
            <MudCardMedia Image="@item.ImagemUrl" Height="250" Width="250" />
            <MudCardContent>
                <MudText Typo="Typo.h5">@item.Nome</MudText>
                <MudText Typo="Typo.body1">@item.Preco.ToString("c")</MudText>

                <MudText Typo="Typo.body2">@item.CategoriaNome</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary">Detalhes</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
}
@code {
    [Parameter]
    public IEnumerable<ProdutoDto>? Produtos { get; set; }

}
