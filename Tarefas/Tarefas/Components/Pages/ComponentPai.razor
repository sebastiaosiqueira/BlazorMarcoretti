@page "/estilo-cascading"
<h3 style="@Estilo">Componente Pai</h3>

<CascadingValue Value="@Estilo"  Name="Estilo">
    <CascadingValue Value="@Data">
        <CascadingValue Value="@Fonte" Name="Fonte">

        </CascadingValue>
    <ComponenteFilho/>
    </CascadingValue>

</CascadingValue>

@code {
    public string Estilo { get; set; } = "color:blue; font-weight:bold";
    public DateTime Data { get; set; } = DateTime.Now;
    public string Fonte { get; set; } = "font-family:Courier New; font-size:46px";

}
