@page "/bind-event"
@rendermode InteractiveServer
<h3>Exemplo com <code>@("@bind:event")</code></h3>

<h3 style="color:red"> 1 - Usando bind padrão (usa onchange)></h3>
<p>Digite algo:</p>
<input @bind="texto1" />
<p style="font-size: 20px;">Valor atual: @texto1</p>
<hr />

<h3 style="color:blue"> 1 - Usando bind event  (com inpunt)></h3>
<p>Digite algo:</p>
<input @bind="texto2"  @bind:event="oninput"/>
<p style="font-size: 20px;">Valor atual: @texto2</p>

@code {
    private string texto1 = "";
    private string texto2 = "";

}
