
<button class="btn btn-info" @onclick="ExibirMensagemClick">
    Exibir Mensagem
</button>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-success mt-3">
        @mensagem
    </div>
}
@code {
    private string? mensagem;

    private void ExibirMensagemClick()
    {
        mensagem = "Testando os modos de renderização do Blazor";
    }

}
