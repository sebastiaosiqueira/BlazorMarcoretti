@using System.Security.Claims;
@using Microsoft.AspNetCore.Components.Authorization



    <AuthorizeView>
    <Authorized>
       @context.User.Identity.Name
       <a href="/LogOut">Log Out</a>
    </Authorized>
    <NotAuthorized>
        <a href="/Login">Log In</a>
    </NotAuthorized>
    </AuthorizeView>

